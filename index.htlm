<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sidney Pereira - Fine Art Photography</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            color: #333;
            line-height: 1.6;
            background: #fafafa;
        }

        header {
            background: white;
            padding: 40px 0;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        h1 {
            font-size: 24px;
            font-weight: 300;
            letter-spacing: 2px;
        }

        nav {
            display: flex;
            gap: 40px;
        }

        nav a {
            text-decoration: none;
            color: #666;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #000;
        }

        .hero {
            height: 80vh;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .hero-content h2 {
            font-size: 48px;
            font-weight: 300;
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        .hero-content p {
            font-size: 18px;
            color: #666;
            max-width: 600px;
            margin: 0 auto;
        }

        section {
            padding: 80px 0;
            background: white;
            margin-bottom: 40px;
        }

        .section-header {
            display: flex;
            align-items: flex-start;
            gap: 40px;
            margin-bottom: 60px;
        }

        .section-number {
            font-size: 48px;
            color: #ddd;
            font-weight: 300;
            min-width: 60px;
        }

        .section-title {
            font-size: 36px;
            font-weight: 300;
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        .section-desc {
            color: #666;
            font-size: 14px;
            line-height: 1.8;
            max-width: 600px;
        }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
        }

        .photo-item {
            background: #f5f5f5;
            aspect-ratio: 1;
            overflow: hidden;
            position: relative;
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .photo-item:hover img {
            transform: scale(1.05);
        }

        .video-item {
            background: #f5f5f5;
        }

        .video-frame {
            width: 100%;
            padding-bottom: 56.25%;
            position: relative;
            background: #000;
            margin-bottom: 20px;
            border-radius: 4px;
            overflow: hidden;
        }

        .video-frame iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        .video-frame video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .video-info h3 {
            font-size: 16px;
            margin-bottom: 8px;
        }

        .video-info p {
            font-size: 13px;
            color: #666;
        }

        footer {
            background: #fff;
            padding: 60px 0;
            border-top: 1px solid #eee;
            text-align: center;
            font-size: 12px;
            color: #999;
        }

        .menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
        }

        .empty-state {
            grid-column: 1/-1;
            text-align: center;
            color: #999;
            padding: 40px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 20px;
            }

            nav {
                display: none;
            }

            .menu-btn {
                display: block;
            }

            .hero-content h2 {
                font-size: 32px;
            }

            .hero-content p {
                font-size: 16px;
            }

            .section-title {
                font-size: 24px;
            }

            .featured-grid {
                grid-template-columns: 1fr;
            }

            .section-header {
                flex-direction: column;
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="header-content">
                <h1>SIDNEY PEREIRA</h1>
                <nav>
                    <a href="#portfolio">/01 PORTFOLIO</a>
                    <a href="#videos">/02 VIDEOS</a>
                    <a href="#about">/03 SOBRE</a>
                    <a href="#contact">/04 CONTATO</a>
                </nav>
                <button class="menu-btn">☰</button>
            </div>
        </div>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h2>Fine Art Photography</h2>
            <p>Explorando a beleza atraves da lente. Cada imagem conta uma historia.</p>
        </div>
    </section>

    <section id="portfolio">
        <div class="container">
            <div class="section-header">
                <div class="section-number">/01</div>
                <div>
                    <h2 class="section-title">Portfolio</h2>
                    <p class="section-desc">Galeria de trabalhos fotograficos selecionados.</p>
                </div>
            </div>
            <div class="featured-grid" id="fotosGrid">
                <div class="empty-state">Carregando fotos...</div>
            </div>
        </div>
    </section>

    <section id="videos">
        <div class="container">
            <div class="section-header">
                <div class="section-number">/02</div>
                <div>
                    <h2 class="section-title">Videos</h2>
                    <p class="section-desc">Explore videos que mostram o processo criativo.</p>
                </div>
            </div>
            <div class="featured-grid" id="videosGrid">
                <div class="empty-state">Em breve...</div>
            </div>
        </div>
    </section>

    <section id="about">
        <div class="container">
            <div class="section-header">
                <div class="section-number">/03</div>
                <div>
                    <h2 class="section-title">Sobre</h2>
                    <p class="section-desc">Fotografo especializado em fine art photography, trabalhando com foco em composicao, luz e narrativa visual. Com experiencia em comunicacao politica, media training e gestao de crise.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="contact">
        <div class="container">
            <div class="section-header">
                <div class="section-number">/04</div>
                <div>
                    <h2 class="section-title">Contato</h2>
                    <p class="section-desc">Entre em contato para projetos, duvidas ou parcerias. Sidney Pereira InsightTech</p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2026 Sidney Pereira. Fine Art Photography. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script>
        let db;
        const dbName = "SidneyPhotoDB";
        const storeName = "videos";

        function initDB() {
            return new Promise((resolve, reject) => {
                try {
                    const request = indexedDB.open(dbName, 1);
                    
                    request.onerror = () => reject(request.error);
                    request.onsuccess = () => {
                        db = request.result;
                        resolve(db);
                    };
                    
                    request.onupgradeneeded = (e) => {
                        const database = e.target.result;
                        if (!database.objectStoreNames.contains(storeName)) {
                            database.createObjectStore(storeName, { keyPath: 'id' });
                        }
                    };
                } catch (e) {
                    reject(e);
                }
            });
        }

        function carregarFotos() {
            try {
                const fotos = JSON.parse(localStorage.getItem("fotos")) || [];
                const grid = document.getElementById("fotosGrid");

                if (fotos.length === 0) {
                    grid.innerHTML = '<div class="empty-state">Nenhuma foto adicionada ainda.</div>';
                    return;
                }

                grid.innerHTML = fotos.map(foto => `
                    <div class="photo-item">
                        <img src="${foto.url}" alt="${foto.titulo || 'Foto'}">
                    </div>
                `).join("");
            } catch (e) {
                console.log("Erro ao carregar fotos:", e);
            }
        }

        function carregarVideos() {
            if (!db) return;
            
            try {
                const transaction = db.transaction([storeName], "readonly");
                const store = transaction.objectStore(storeName);
                const request = store.getAll();
                
                request.onsuccess = () => {
                    const videos = request.result;
                    const grid = document.getElementById("videosGrid");

                    if (videos.length === 0) {
                        grid.innerHTML = '<div class="empty-state">Videos em breve...</div>';
                        return;
                    }

                    grid.innerHTML = videos.map(video => {
                        let conteudo = '';
                        
                        if (video.url.startsWith('data:video')) {
                            conteudo = `<video controls style="width: 100%; height: 100%;"><source src="${video.url}" type="video/mp4"></video>`;
                        } else if (video.url.includes('youtube.com') || video.url.includes('youtu.be')) {
                            const videoId = video.url.split('v=')[1] || video.url.split('/').pop();
                            conteudo = `<iframe src="https://www.youtube.com/embed/${videoId}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
                        } else if (video.url.includes('vimeo.com')) {
                            const videoId = video.url.split('/').pop();
                            conteudo = `<iframe src="https://player.vimeo.com/video/${videoId}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
                        }
                        
                        return `
                        <div class="video-item">
                            <div class="video-frame">
                                ${conteudo}
                            </div>
                            <div class="video-info">
                                <h3>${video.titulo || 'Video'}</h3>
                                <p>${video.descricao || ''}</p>
                            </div>
                        </div>`;
                    }).join("");
                };
            } catch (e) {
                console.log("Erro ao carregar videos:", e);
            }
        }

        window.addEventListener("load", async () => {
            try {
                await initDB();
            } catch (e) {
                console.log("IndexedDB nao disponivel");
            }
            carregarFotos();
            carregarVideos();
        });
    </script>
</body>
</html>
